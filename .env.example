WORKSTATION_AGENT_WORKSPACE=.
WORKSTATION_AGENT_MAX_STEPS=8
WORKSTATION_AGENT_MODEL=
WORKSTATION_AGENT_DATA_DIR=.workstation-agent
WORKSTATION_AGENT_TOOL_OUTPUT_CHARS=50000

WORKSTATION_AGENT_SERVICE_PORT=8765
# serve 必须配置访问令牌；通过环境变量注入 32–256 个 URL 安全字符。
# 未配置令牌时，Windows 启动脚本会在当前进程环境中生成令牌。
WORKSTATION_AGENT_SERVICE_TOKEN=

# 模型必须支持 OpenAI 兼容的 Chat Completions 和工具调用；项目不会自动读取此文件。
WORKSTATION_AGENT_API_KEY=
WORKSTATION_AGENT_BASE_URL=https://api.openai.com/v1
WORKSTATION_AGENT_MODEL_TIMEOUT=30
WORKSTATION_AGENT_MAX_TOOL_CALLS=32

# RAG：默认结构前缀 + 离线 BM25，模型名称必须对应实际服务。
# ALLOW_REMOTE=true 授权将文档与查询发送到 BASE_URL；MCP 服务需重启读取环境。
WORKSTATION_AGENT_RAG_EMBEDDING_MODEL=
WORKSTATION_AGENT_RAG_CONTEXT_MODEL=
WORKSTATION_AGENT_RAG_ALLOW_REMOTE=false
WORKSTATION_AGENT_RAG_CHUNK_SIZE=1000
WORKSTATION_AGENT_RAG_CHUNK_OVERLAP=100
WORKSTATION_AGENT_RAG_MAX_FILE_BYTES=1000000
WORKSTATION_AGENT_RAG_MAX_CHUNKS=10000
WORKSTATION_AGENT_RAG_CONTEXT_BUDGET=8000
WORKSTATION_AGENT_RAG_RECALL_LIMIT=20
WORKSTATION_AGENT_RAG_RERANK_LIMIT=30
WORKSTATION_AGENT_RAG_SEARCH_LIMIT=6
WORKSTATION_AGENT_RAG_EXPANSION=1
WORKSTATION_AGENT_RAG_EXPAND_PARENT=false
WORKSTATION_AGENT_RAG_MAX_SEARCH_CALLS=6
WORKSTATION_AGENT_RAG_INPUT_BUDGET=8192
WORKSTATION_AGENT_RAG_MAX_MODEL_CALLS=64

# 文本长期记忆与会话；额外出站和自动提取均默认关闭。
WORKSTATION_AGENT_MEMORY_ENABLED=true
WORKSTATION_AGENT_USER_ID=local
WORKSTATION_AGENT_PROJECT_ID=
WORKSTATION_AGENT_SESSIONS_ENABLED=false
WORKSTATION_AGENT_MEMORY_AUTO_EXTRACT=false
WORKSTATION_AGENT_MEMORY_ALLOW_REMOTE=false
WORKSTATION_AGENT_MEMORY_CONTEXT_CHARS=4000
WORKSTATION_AGENT_MEMORY_SEARCH_LIMIT=5
WORKSTATION_AGENT_MEMORY_MAX_RECORDS=2000
WORKSTATION_AGENT_MEMORY_EXTRACT_CHARS=6000
WORKSTATION_AGENT_MEMORY_EXTRACT_LIMIT=5
WORKSTATION_AGENT_MEMORY_EXTRACT_CALLS=3
# 上下文预算：自定义模型必须填写真实窗口；留空时只允许读取可信模型资料。
WORKSTATION_AGENT_CONTEXT_WINDOW=
WORKSTATION_AGENT_CONTEXT_INPUT_LIMIT=
WORKSTATION_AGENT_CONTEXT_OUTPUT_LIMIT=
WORKSTATION_AGENT_CONTEXT_OUTPUT_TOKENS=2048
WORKSTATION_AGENT_CONTEXT_SAFETY_TOKENS=1024
WORKSTATION_AGENT_CONTEXT_TRIGGER_RATIO=0.8
# 摘要还需 MEMORY_ALLOW_REMOTE=true；无需启用会话即可使用。
WORKSTATION_AGENT_CONTEXT_SUMMARIZE=false
WORKSTATION_AGENT_CONTEXT_REFRESH_LIMIT=2

# 整次运行的时间上限，单位为秒；包括审批等待，恢复不会重新计时。
WORKSTATION_AGENT_RUN_TIMEOUT=300
# 状态栏可选内容的 Token 上限；目标、约束和验收条件不会静默截断。
WORKSTATION_AGENT_CONTEXT_BOARD_TOKENS=1024
